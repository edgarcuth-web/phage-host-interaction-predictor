  "metrics": {
    "hit": "Exact within-tie expected probability of at least one source-positive candidate in the first K.",
    "tests": "E[min(T,K)] = K - sum(Hit@j for j=1..K-1), stop at first positive; T=infinity for all-negative hosts, which spend K.",
    "mrr": "Existing exact-tie reciprocal first-positive rank; zero for all-negative hosts. Distinct from mean first-positive rank.",
    "cost_model": "One equal-cost test per candidate, perfect source-label observation, sequential stopping; excludes real assay noise, batch overhead and clinical costs.",
    "availability": "Full scores support every frozen budget. Published metric points support only stored Hit@K/MRR and capped costs whose preceding Hit@j values all exist. Missing values are never interpolated.",
    "denominators": [
      "all_complete_hosts",
      "eligible_complete_hosts"
    ],
    "unknowns": "Keep all 94 candidates in inference. Exclude an entire host with any unknown library label from metrics; retain exclusion ledger. Keep complete all-negative hosts in the primary denominator.",
    "random": "All-zero scores induce the exact uniform-random-order expectation."
  },
  "statistics": {
    "contrast": "Each available method minus train-only phage prevalence on identical hosts, budgets and denominators. Cost differences below zero mean fewer tests.",
    "bootstrap": {
      "resamples": 2000,
      "seed": 20261024,
      "confidence": 0.95
    },
    "unit": "Frozen host group; each draw retains all its hosts and the paired method scores; recompute host-macro means.",
